{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voboost.ru/schemas/ci-vehicle-evidence.schema.json",
  "title": "Voboost CI vehicle evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseIdentity", "producer", "product", "ci", "artifactSet", "artifactSetSha256", "vehicle", "uninstall", "cleanState"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseIdentity": { "const": "1.0.0-beta1" },
    "producer": { "$ref": "#/$defs/producer" },
    "product": { "$ref": "#/$defs/product" },
    "ci": { "$ref": "#/$defs/ci" },
    "artifactSet": { "$ref": "#/$defs/artifactSet" },
    "artifactSetSha256": { "$ref": "#/$defs/sha256" },
    "vehicle": { "$ref": "#/$defs/vehicleReceipt" },
    "uninstall": { "$ref": "#/$defs/receipt" },
    "cleanState": { "$ref": "#/$defs/receipt" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "positiveStringInteger": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "workflowPath", "workflowCommitSha", "workflowBlobSha", "ref", "runId", "runAttempt", "job", "artifactName"],
      "properties": {
        "repository": { "const": "voboost/voboost" }, "workflowPath": { "const": ".github/workflows/beta1-evidence-ingest.yml" },
        "workflowCommitSha": { "$ref": "#/$defs/sha1" }, "workflowBlobSha": { "$ref": "#/$defs/sha1" },
        "ref": { "const": "refs/heads/main" }, "runId": { "$ref": "#/$defs/positiveStringInteger" },
        "runAttempt": { "$ref": "#/$defs/positiveStringInteger" }, "job": { "const": "ingest" },
        "artifactName": { "const": "beta1-ci-vehicle-evidence" }
      }
    },
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "workflowBlobSha", "sourceDefinitionSha256", "trustDocumentSha256"],
      "properties": { "commit": { "$ref": "#/$defs/sha1" }, "workflowBlobSha": { "$ref": "#/$defs/sha1" }, "sourceDefinitionSha256": { "$ref": "#/$defs/sha256" }, "trustDocumentSha256": { "$ref": "#/$defs/sha256" } }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["id", "digest", "payloadSha256"],
      "properties": { "id": { "$ref": "#/$defs/positiveStringInteger" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "payloadSha256": { "$ref": "#/$defs/sha256" } }
    },
    "ci": {
      "type": "object", "additionalProperties": false, "required": ["runId", "runAttempt", "finalClosure", "installerPackages"],
      "properties": {
        "runId": { "$ref": "#/$defs/positiveStringInteger" }, "runAttempt": { "$ref": "#/$defs/positiveStringInteger" },
        "finalClosure": { "$ref": "#/$defs/artifact" }, "installerPackages": { "$ref": "#/$defs/artifact" }
      }
    },
    "artifactSet": {
      "type": "object", "additionalProperties": false, "required": ["schemaVersion", "artifacts"],
      "properties": { "schemaVersion": { "const": 1 }, "artifacts": { "type": "array", "minItems": 1, "maxItems": 1024, "items": { "$ref": "#/$defs/artifactRow" } } }
    },
    "artifactRow": {
      "type": "object", "additionalProperties": false, "required": ["component", "file", "size", "sha256"],
      "properties": {
        "component": { "enum": ["product", "app", "agents", "inject", "installer", "license", "logo"] },
        "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false, "required": ["status", "receiptSha256", "completedAt", "nonce", "sequence", "artifactSetSha256", "previousReceiptSha256"],
      "properties": { "status": { "const": "passed" }, "receiptSha256": { "$ref": "#/$defs/sha256" }, "completedAt": { "type": "string", "format": "date-time" }, "nonce": { "$ref": "#/$defs/sha256" }, "sequence": { "type": "integer", "minimum": 1, "maximum": 3 }, "artifactSetSha256": { "$ref": "#/$defs/sha256" }, "previousReceiptSha256": { "$ref": "#/$defs/sha256" } }
    },
    "vehicleReceipt": { "type": "object", "additionalProperties": false, "required": ["status", "receiptSha256", "completedAt", "nonce", "sequence", "artifactSetSha256", "previousReceiptSha256", "vehicleIdentitySha256", "firmware"], "properties": { "status": { "const": "passed" }, "receiptSha256": { "$ref": "#/$defs/sha256" }, "completedAt": { "type": "string", "format": "date-time" }, "nonce": { "$ref": "#/$defs/sha256" }, "sequence": { "type": "integer", "minimum": 1, "maximum": 3 }, "artifactSetSha256": { "$ref": "#/$defs/sha256" }, "previousReceiptSha256": { "$ref": "#/$defs/sha256" }, "vehicleIdentitySha256": { "$ref": "#/$defs/sha256" }, "firmware": { "type": "string", "minLength": 1, "maxLength": 256 } } }
  }
}
