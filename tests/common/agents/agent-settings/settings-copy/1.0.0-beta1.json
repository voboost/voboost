          },
          {
            "description": "键盘仅保留英语布局。",
            "id": "keyboard-en",
            "title": "英语键盘"
          },
          {
            "description": "在主屏幕显示您的应用、保留图标顺序并管理应用窗口。",
            "id": "launcher",
            "title": "启动器"
          },
          {
            "description": "保留完整电话号码以及名字与姓氏之间的空格。",
            "id": "phone",
            "title": "蓝牙联系人"
          },
          {
            "description": "将支持的第三方媒体应用程序集成到原车媒体界面。",
            "id": "media-apps",
            "title": "媒体应用"
          },
          {
            "description": "为第三方应用显示原车媒体弹窗。",
            "id": "media-popup-external-apps",
            "title": "第三方媒体弹窗"
          },
          {
            "description": "使用方向盘控制键切换媒体应用。",
            "id": "steering-media-app-switcher",
            "title": "方向盘切换媒体应用"
          },
          {
            "description": "将方向盘媒体控制命令发送到当前媒体会话。",
            "id": "steering-media-session",
            "title": "方向盘媒体会话"
          },
          {
            "description": "连续点击版本信息五次后，无需输入密码即可进入原厂工程菜单。其他受保护的操作保持不变。",
            "id": "settings-engineering-menu",
            "title": "免密码工程菜单"
          },
          {
            "description": "启动时跳过原厂激活界面，不改变车辆激活状态。",
            "id": "login-activation-skip",
            "title": "跳过激活界面"
          },
          {
            "description": "在强制纯电模式下，车辆不会启动发动机，直到电池电量降至 10% 或车辆急加速。Voboost 会记住您的选择，并在车辆启动及重新切换到纯电模式时恢复该选择。如果您关闭此模式，Voboost 不会再次开启它。",
            "id": "vehicle-drive-forced-ev",
            "title": "强制纯电模式"
          },
          {
            "description": "在车辆设置中关闭低速行驶时的“飞碟”提示音。Voboost 会在下次启动车辆时保持关闭。驾驶员仪表左上角的黄色图标表示提示音已关闭。",
            "id": "vehicle-drive-pedestrian-warning",
            "title": "关闭行人提示音"
          },
          {
            "description": "显示原车显示屏自动升降设置。",
            "id": "vehicle-display-auto-lift",
            "title": "显示屏自动升降"
          },
          {
            "description": "配置达到限速时退出郊游模式的原厂行为。",
            "id": "vehicle-drive-outing",
            "title": "郊游驾驶模式行为"
          },
          {
            "description": "在系统语言选项中添加俄语，未翻译的内容使用英语。",
            "id": "i18n-ru",
            "title": "俄语"
          }
        ],
