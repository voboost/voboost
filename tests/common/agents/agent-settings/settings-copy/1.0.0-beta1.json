        "vehicleGroup": "Vehicle",
        "checkboxes": [
          {
            "description": "Removes wide gaps between Cyrillic letters in menus and navigation.",
            "id": "font-cyrillic",
            "title": "Cyrillic in OEM fonts"
          },
          {
            "description": "Replaces Chinese with Russian and keeps English available.",
            "id": "keyboard-ru",
            "title": "Russian keyboard"
          },
          {
            "description": "Keeps only the English keyboard layout.",
            "id": "keyboard-en",
            "title": "English keyboard"
          },
          {
            "description": "Shows your apps on the home screen, keeps their icon order and manages application windows.",
            "id": "launcher",
            "title": "Launcher"
          },
          {
            "description": "Keeps complete phone numbers and spaces between first and last names.",
            "id": "phone",
            "title": "Bluetooth contacts"
          },
          {
            "description": "Integrates supported third-party media applications with the stock media interface.",
            "id": "media-apps",
            "title": "Media applications"
          },
          {
            "description": "Shows the stock media popup for third-party applications.",
            "id": "media-popup-external-apps",
            "title": "External media popup"
          },
          {
            "description": "Uses steering-wheel controls to switch between media applications.",
            "id": "steering-media-app-switcher",
            "title": "Steering-wheel media app switcher"
          },
          {
            "description": "Routes steering-wheel media controls to the active media session.",
            "id": "steering-media-session",
            "title": "Steering-wheel media session"
          },
          {
            "description": "Adds access to the stock system engineering menu without a password.",
            "id": "settings-engineering-menu",
            "title": "Engineering menu without password"
          },
          {
            "description": "Skips the stock activation screen during startup.",
            "id": "login-activation-skip",
            "title": "Skip activation screen"
          },
          {
            "description": "In Forced EV mode, the vehicle will not start the combustion engine until the battery charge drops to 10% or the vehicle accelerates sharply. Voboost remembers your choice and restores it when the vehicle starts and when you return to electric mode. If you turn this mode off, Voboost will not turn it back on.",
            "id": "vehicle-drive-forced-ev",
            "title": "Forced EV mode"
          },
          {
            "description": "Turn off the low-speed “flying saucer” sound in the vehicle settings. Voboost will keep it off after you restart the vehicle. A yellow icon at the top left of the driver display shows that the sound is disabled.",
            "id": "vehicle-drive-pedestrian-warning",
            "title": "Disable pedestrian warning sound"
          },
          {
            "description": "Shows the stock automatic display movement setting.",
            "id": "vehicle-display-auto-lift",
            "title": "Automatic display lift"
          },
          {
            "description": "Configures the stock speed-based exit from Outing.",
            "id": "vehicle-drive-outing",
            "title": "Outing drive-mode behavior"
          },
          {
            "description": "Adds Russian to the system language selection. Untranslated text uses English.",
            "id": "i18n-ru",
            "title": "Russian language"
          }
        ],
