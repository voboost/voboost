{
  "schemaVersion": 1,
  "softwareContract": "1.0.0-beta1",
  "copy": {
    "languages": {
      "ru": {
        "vehicleGroup": "Автомобиль",
        "checkboxes": [
          {
            "description": "Убирает лишние промежутки между русскими буквами в меню и навигации.",
            "id": "font-cyrillic",
            "title": "Кириллица в штатных шрифтах"
          },
          {
            "description": "Заменяет китайскую раскладку русской, сохраняя английскую.",
            "id": "keyboard-ru",
            "title": "Русская клавиатура"
          },
          {
            "description": "Оставляет в клавиатуре только английскую раскладку.",
            "id": "keyboard-en",
            "title": "Английская клавиатура"
          },
          {
            "description": "Показывает ваши приложения на главном экране, сохраняет порядок значков и управляет окнами приложений.",
            "id": "launcher",
            "title": "Лаунчер"
          },
          {
            "description": "Сохраняет полные номера телефонов и пробелы между именем и фамилией.",
            "id": "phone",
            "title": "Контакты Bluetooth"
          },
          {
            "description": "Интегрирует поддерживаемые сторонние медиаприложения со штатным медиаинтерфейсом.",
            "id": "media-apps",
            "title": "Медиаприложения"
          },
          {
            "description": "Показывает штатный медиапопап для сторонних приложений.",
            "id": "media-popup-external-apps",
            "title": "Попап стороннего медиа"
          },
          {
            "description": "Переключает медиаприложения органами управления на руле.",
            "id": "steering-media-app-switcher",
            "title": "Переключение медиаприложений на руле"
          },
          {
            "description": "Направляет команды медиа с руля в активную медиасессию.",
            "id": "steering-media-session",
            "title": "Медиасессия на руле"
          },
          {
            "description": "Добавляет вход в штатное системное инженерное меню без пароля.",
            "id": "settings-engineering-menu",
            "title": "Инженерное меню без пароля"
          },
          {
            "description": "Пропускает штатный экран активации при запуске.",
            "id": "login-activation-skip",
            "title": "Пропуск экрана активации"
          },
          {
            "description": "Машина не включает ДВС, пока заряд батареи не снизится до 10% или скорость резко не увеличится. Запоминает ваш выбор и восстанавливает режим при запуске машины и возврате в электрорежим. Если выключить режим вручную, он останется выключенным.",
            "id": "vehicle-drive-forced-ev",
            "title": "Принудительное электро"
          },
          {
            "description": "Выключите звук «летающей тарелки» в настройках машины. Voboost сохранит ваш выбор при следующем запуске. Этот звук слышен при движении на низкой скорости. Когда он выключен, на приборке водителя появляется жёлтый значок в левом верхнем углу.",
            "id": "vehicle-drive-pedestrian-warning",
            "title": "Отключить звук предупреждения пешеходов"
          },
          {
            "description": "Показывает штатную настройку автоматического движения дисплеев.",
            "id": "vehicle-display-auto-lift",
            "title": "Автоматический подъём дисплеев"
          },
          {
            "description": "Настраивает штатный выход из Outing при достижении ограничения скорости.",
            "id": "vehicle-drive-outing",
            "title": "Поведение режима движения Outing"
          },
          {
            "description": "Добавляет русский язык в штатный выбор языка. Непереведённые тексты остаются на английском.",
            "id": "i18n-ru",
            "title": "Русский язык"
          }
        ],
        "uninstall": {
          "buttonText": "Удалить",
          "cancelLabel": "Отмена",
          "confirmLabel": "Удалить",
          "description": "Полностью удалить Voboost. После подтверждения ничего не нажимайте и дождитесь одного завершающего перезапуска мультимедиа.",
          "retryableError": "Не удалось открыть подтверждение Voboost или проверить его результат. Нажмите «Удалить Voboost», чтобы повторить попытку.",
          "started": "Удаление запущено. Очистка продолжится автоматически. Ничего не нажимайте и дождитесь одного завершающего перезапуска мультимедиа.",
          "awaitingConfirmation": "Открыто подтверждение Voboost. Подтвердите или отмените удаление в нём.",
          "group": "Удаление"
        },
        "startup": [
          {
            "description": "При следующем запуске машины Voboost будет работать с видимой вкладкой настроек.",
            "label": "Нормально",
            "value": "interface"
          },
          {
            "description": "При следующем запуске машины Voboost будет работать, но вкладка будет скрыта. Чтобы открыть её, несколько раз быстро нажмите на версию TBOX в разделе «Система».",
            "label": "Скрытно",
            "value": "hidden"
          },
          {
            "description": "При выборе «Не запускать» Voboost не будет запускаться при старте машины, пока вы не измените эту настройку на «Нормально» или «Скрытно». Для этого подключите компьютер и используйте voboost-installer.",
            "label": "Не запускать",
            "value": "none"
          }
        ],
